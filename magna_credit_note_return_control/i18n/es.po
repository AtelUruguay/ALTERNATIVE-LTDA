#. module: magna_credit_note_return_control
#: code:addons/magna_credit_note_return_control/models/account_move.py:0
#, python-format
msgid "The reason is missing on credit note %s. Please set it before posting the credit note."
msgstr "Falta el motivo en la nota de crédito %s. Debe indicarlo antes de confirmarla."

#. module: magna_credit_note_return_control
#: code:addons/magna_credit_note_return_control/models/account_move.py:0
#, python-format
msgid "Credit note %(move)s is issued for a goods return but the returned goods cannot be traced back to a valid receipt:"
msgstr "La nota de crédito %(move)s se emite por devolución de mercadería, pero la mercadería devuelta no puede trazarse a un remito válido:"

#. module: magna_credit_note_return_control
#: code:addons/magna_credit_note_return_control/models/account_move.py:0
#, python-format
msgid "No return receipt is referenced."
msgstr "No se indicó ningún remito de devolución."

#. module: magna_credit_note_return_control
#: code:addons/magna_credit_note_return_control/models/account_move.py:0
#, python-format
msgid "Transfer %s is not a receipt."
msgstr "La transferencia %s no es una recepción."

#. module: magna_credit_note_return_control
#: code:addons/magna_credit_note_return_control/models/account_move.py:0
#, python-format
msgid "Return receipt %(picking)s is not done yet (current status: %(state)s)."
msgstr "El remito de devolución %(picking)s no está en estado Hecho (estado actual: %(state)s)."

#. module: magna_credit_note_return_control
#: code:addons/magna_credit_note_return_control/models/account_move.py:0
#, python-format
msgid "Return receipt %(picking)s belongs to %(picking_partner)s instead of %(partner)s."
msgstr "El remito de devolución %(picking)s corresponde a %(picking_partner)s y no a %(partner)s."

#. module: magna_credit_note_return_control
#: code:addons/magna_credit_note_return_control/models/account_move.py:0
#, python-format
msgid "no customer"
msgstr "sin cliente"

#. module: magna_credit_note_return_control
#: code:addons/magna_credit_note_return_control/models/account_move.py:0
#, python-format
msgid "Return receipt %(picking)s already backs the posted credit note(s) %(credit_notes)s."
msgstr "El remito de devolución %(picking)s ya respalda la/s nota/s de crédito confirmada/s %(credit_notes)s."

#. module: magna_credit_note_return_control
#: code:addons/magna_credit_note_return_control/models/account_move.py:0
#, python-format
msgid "Fill in the return control exception to post it anyway; the justification will be logged in the chatter."
msgstr "Complete la excepción al control de devolución para confirmarla de todos modos; la justificación quedará registrada en el chatter."

#. module: magna_credit_note_return_control
#: code:addons/magna_credit_note_return_control/models/account_move.py:0
#, python-format
msgid "Return control bypassed by %s."
msgstr "Control de devolución omitido por %s."

#. module: magna_credit_note_return_control
#: code:addons/magna_credit_note_return_control/models/account_move.py:0
#, python-format
msgid "Justification: %s"
msgstr "Justificación: %s"

#. module: magna_credit_note_return_control
#: code:addons/magna_credit_note_return_control/models/account_move.py:0
#, python-format
msgid "A return receipt may only be set on a customer credit note."
msgstr "Solo puede indicarse un remito de devolución en una nota de crédito de cliente."

#. module: magna_credit_note_return_control
#: code:addons/magna_credit_note_return_control/models/account_move.py:0
#, python-format
msgid "Transfer %s is not a receipt and cannot back a credit note."
msgstr "La transferencia %s no es una recepción y no puede respaldar una nota de crédito."

#. module: magna_credit_note_return_control
#: code:addons/magna_credit_note_return_control/models/account_move.py:0
#, python-format
msgid "Return receipt %(picking)s does not belong to %(partner)s."
msgstr "El remito de devolución %(picking)s no corresponde a %(partner)s."

#. module: magna_credit_note_return_control
#: model_terms:ir.ui.view,arch_db:magna_credit_note_return_control.view_move_form
msgid "Justify posting this credit note without a valid return receipt..."
msgstr "Justifique la confirmación de esta nota de crédito sin un remito de devolución válido..."
