<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_picking_form" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.credit.note.return.control</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_credit_notes" type="object"
                        class="oe_stat_button" icon="fa-pencil-square-o"
                        invisible="credit_note_count == 0"
                        groups="account.group_account_invoice,account.group_account_readonly">
                    <field name="credit_note_count" widget="statinfo" string="Credit Notes"/>
                </button>
            </xpath>
        </field>
    </record>

</odoo>
