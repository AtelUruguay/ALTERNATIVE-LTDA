<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_move_form" model="ir.ui.view">
        <field name="name">account.move.form.inherit.credit.note.return.control</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@id='header_right_group']" position="inside">
                <field name="available_return_picking_ids" invisible="1"/>
                <field name="credit_note_reason"
                       invisible="move_type != 'out_refund'"
                       required="move_type == 'out_refund'"
                       readonly="state != 'draft'"/>
                <field name="return_picking_id"
                       invisible="move_type != 'out_refund' or credit_note_reason != 'goods_return'"
                       readonly="state != 'draft'"
                       domain="[('id', 'in', available_return_picking_ids)]"
                       options="{'no_create': True}"/>
                <field name="return_control_exception_reason"
                       invisible="move_type != 'out_refund' or credit_note_reason != 'goods_return'"
                       readonly="state != 'draft'"
                       placeholder="Justify posting this credit note without a valid return receipt..."/>
            </xpath>
        </field>
    </record>

</odoo>
