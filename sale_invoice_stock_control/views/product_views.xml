<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="product_template_form_view" model="ir.ui.view">
        <field name="name">product.template.form.inherit.invoice.stock.control</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='sales']/group[@name='sale']" position="after">
                <group name="stock_invoice_control" string="Stock Control">
                    <field name="check_stock_before_invoice"
                           invisible="detailed_type != 'product'"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
