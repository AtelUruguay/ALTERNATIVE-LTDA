<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_order_form" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.invoice.stock.control</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='other_information']" position="inside">
                <group name="stock_invoice_control" string="Stock Control"
                       groups="sale_invoice_stock_control.group_invoice_without_stock">
                    <field name="stock_control_override_reason"
                           placeholder="Justify invoicing this order without enough stock..."/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
