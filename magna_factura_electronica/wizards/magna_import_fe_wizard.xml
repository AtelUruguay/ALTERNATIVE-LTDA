<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- View magna_import_fe_wizard form -->
    <record id="view_magna_import_fe_wizard_form" model="ir.ui.view">
        <field name="name">view.magna_import_fe_wizard.form</field>
        <field name="model">magna_import_fe_wizard</field>
        <field name="arch" type="xml">
            <form string="Importar datos de Factura Electrónica">
                <div>
                    Importar datos de FE desde fichero de ProInfo
                    <br/>
                    <br/>
                </div>                                    
                <field name="import_file" placeholder="Fichero a importar..." filename="import_file_name"/>
                <field name="import_file_name" invisible="1"/>                                    
                <footer>
                    <button name="button_import_file" type="object" string="Importar" class="oe_highlight"/>
                    <button special="cancel" string="Cancelar"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action magna_import_fe_wizard -->
    <record id="action_magna_import_fe_wizard" model="ir.actions.act_window">
        <field name="name">Importar datos de Factura Electrónica</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">magna_import_fe_wizard</field>
        <field name="view_mode">form</field>        
        <field name="target">new</field>
    </record>

    <!-- Menu item for magna_import_fe_wizard -->
    <menuitem id="menu_magna_import_fe_wizard"
        name="Importar Factura Electrónica"
        action="action_magna_import_fe_wizard"
        groups="base.group_no_one"
        parent="account.account_management_menu"
        sequence="100"/>

</odoo>
